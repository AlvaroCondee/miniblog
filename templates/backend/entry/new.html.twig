{% extends 'backend/layout.html.twig' %}

{% block title 'Crear nueva entrada' %}

{% block container %}
<div id="core" class="container clearfix">
    <div id="primary-content" class="clearfix">
        <h2>Crear nueva entrada</h2>

        {{ form_start(form, {action: path('entry_new', {})}) }}
            {{ form_widget(form) }}
            <input type="submit" value="Guardar" />
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'backend/_editor.html.twig' with {field: form.content.vars.full_name} %}
{% endblock %}
