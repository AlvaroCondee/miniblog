{% extends 'backend/layout.html.twig' %}

{% block title 'Editar entrada' %}

{% block container %}
<div id="core" class="container clearfix">
    <div id="primary-content" class="clearfix">
        <h2>Editar entrada</h2>

        {{ form_start(form, {action: path('entry_edit', {'id': entry.id})}) }}
            {{ form_widget(form) }}
            <input type="submit" value="Guardar" />
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    CKEDITOR.replace('{{ form.content.vars.full_name }}');
</script>
{% endblock %}
