{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('css/jekyll.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('css/trassierra.css') }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <header class="ies-header">
        <div class="inner">
            <a href="{{ path('homepage') }}"><img src="{{ asset('img/logo.png') }}" alt="IES Trassierra"></a>
            <p class="tagline"><strong>Blog del IES Trassierra</strong><br>Noticias y actividades de nuestro centro (Córdoba)</p>
        </div>
    </header>
    <nav class="ies-nav">
        <ul>
            <li><a href="{{ path('homepage') }}">Inicio</a></li>
            {% for c in site_categories() %}
                <li><a href="{{ path('category', {slug: c.slug}) }}">{{ c.name }}</a></li>
            {% endfor %}
            <li class="right">
                {% if is_granted('ROLE_USER') %}<a href="{{ path('backend') }}">Mi panel</a>{% else %}<a href="{{ path('login') }}">Acceder</a>{% endif %}
            </li>
        </ul>
    </nav>

    <main class="ies-main">
        {% block container %}{% endblock %}
    </main>
    <footer class="ies-footer">IES Trassierra · Córdoba</footer>
{% endblock %}
