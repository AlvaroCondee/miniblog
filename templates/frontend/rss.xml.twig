<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>Blog del {{ school.name }}</title>
        <link>{{ url('homepage') }}</link>
        <description>Noticias y actividades del {{ school.name }} ({{ school.city }})</description>
        <language>es</language>
        <atom:link href="{{ url('rss') }}" rel="self" type="application/rss+xml" />
{% for entry in entries %}
        <item>
            <title>{{ entry.title }}</title>
            <link>{{ url('entry_show', {id: entry.id}) }}</link>
            <guid isPermaLink="true">{{ url('entry_show', {id: entry.id}) }}</guid>
            <pubDate>{{ entry.created_at|date('r') }}</pubDate>
            {% if entry.category %}<category>{{ entry.category }}</category>{% endif %}
            <description>{{ entry.content|striptags|u.truncate(300, '…') }}</description>
        </item>
{% endfor %}
    </channel>
</rss>
