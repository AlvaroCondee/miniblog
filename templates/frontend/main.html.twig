{% extends 'frontend/layout.html.twig' %}

{% block title 'Frontend - Portada' %}

{% block container %}
<div id="core" class="container clearfix">
    {% for entry in entries %}
    <div class="post">
        <h1>{{ entry.title }}</h1>
        <span class="post-date">{{ entry.created_at|date('d/m/Y H:i') }}</span>
        {# El contenido lo escribe un administrador mediante CKEditor y es HTML #}
        <div>{{ entry.content|raw }}</div>
    </div>
    {% else %}
        <h1>Aún no hay artículos creados</h1>
    {% endfor %}
</div>
{% endblock %}
