{% if pages > 1 %}
<div class="pagination pagination-centered"><ul>
    <li class="{{ page <= 1 ? 'disabled' }}"><a href="{{ page > 1 ? path(route, route_params|merge({page: page - 1})) : '#' }}">&laquo; Anteriores</a></li>
    <li class="disabled"><a href="#">Página {{ page }} de {{ pages }}</a></li>
    <li class="{{ page >= pages ? 'disabled' }}"><a href="{{ page < pages ? path(route, route_params|merge({page: page + 1})) : '#' }}">Siguientes &raquo;</a></li>
</ul></div>
{% endif %}
